{
  "name": "aquarium",
  "version": "0.0.1",
  "private": true,
  "description": "水族箱：会水群的 AI 群友",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "node scripts/patch-snowluma-sdk.mjs",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "check": "npm run typecheck && node scripts/check-boundaries.mjs && npm test",
    "panel:dev": "vite --config panel/vite.config.ts",
    "panel:build": "tsc -p panel/tsconfig.json && vite build --config panel/vite.config.ts",
    "start": "node --env-file-if-exists=.env src/app/main.ts",
    "autostart:install": "node scripts/autostart.mjs install",
    "autostart:uninstall": "node scripts/autostart.mjs uninstall",
    "spike:ping": "node --env-file-if-exists=.env src/spike/ping.ts",
    "spike:adapter-ping": "node --env-file-if-exists=.env src/spike/adapter-ping.ts",
    "spike:llm-ping": "node --env-file-if-exists=.env src/spike/llm-ping.ts",
    "eval": "node src/eval/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@snowluma/sdk": "1.14.22",
    "@trayjs/trayjs": "0.0.10",
    "hono": "4.13.9",
    "openai": "6.40.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
