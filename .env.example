# SnowLuma 发行包所在目录（用于读取 config/onebot_<QQ号>.json 里的端口与 token）
SNOWLUMA_DIR=E:\bot\SnowLuma-v1.14.22-win-x64-lite
# bot 小号的 QQ 号（连接后会校验登录账号必须与此一致）
BOT_UIN=900000001
# DeepSeek 模型 API 密钥（留空后在本地 .env 中填写）
DEEPSEEK_API_KEY=
# MiMo 模型 API 密钥（留空后在本地 .env 中填写）
MIMO_API_KEY=
# 控制台访问密码（留空时控制台不会启动）
AQUARIUM_PANEL_PASSWORD=
# SnowLuma 网页控制台登录密码（留空时 Windows 托管无法登录）
SNOWLUMA_WEBUI_PASSWORD=
